---
import '@/styles/global.css';
import '@/styles/accessibility.css';
import ChatwootWidget from '@/components/ChatwootWidget.astro';
import { siteConfig } from '@/config/site';
import { services } from '@/domain/content';

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  noindex?: boolean;
}

const {
  title: titleProp,
  titleEn,
  description: descriptionProp,
  descriptionEn,
  noindex = false,
} = Astro.props;

const pageLanguage: 'es' | 'en' = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const languageTag = pageLanguage === 'en' ? 'en-IE' : 'es-ES';
const spanishTitle = titleProp ?? siteConfig.title.es;
const englishTitle = titleEn ?? (titleProp ? titleProp : siteConfig.title.en);
const spanishDescription = descriptionProp ?? siteConfig.description.es;
const englishDescription = descriptionEn ?? (descriptionProp ? descriptionProp : siteConfig.description.en);
const title = pageLanguage === 'en' ? englishTitle : spanishTitle;
const description = pageLanguage === 'en' ? englishDescription : spanishDescription;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const spanishUrl = new URL('/', siteConfig.url);
const englishUrl = new URL('/en/', siteConfig.url);
const ogImage = new URL('/assets/images/og-incamdi.png', siteConfig.url);
const logoImage = new URL('/assets/images/logo-incamdi-192.webp', siteConfig.url);
const isLandingPage = /^\/(?:en\/?)?$/.test(Astro.url.pathname);
const ogImageAlt = pageLanguage === 'en'
  ? 'Incamdi — web development, SEO and automation'
  : 'Incamdi — desarrollo web, SEO y automatizaciones';
const businessId = `${siteConfig.url}/#organization`;
const profileUrls = [siteConfig.social.linkedin, siteConfig.social.github];

const serviceOffers = services.map((service) => ({
  '@type': 'Offer',
  itemOffered: {
    '@type': 'Service',
    name: service.title[pageLanguage],
    description: service.description[pageLanguage],
    provider: { '@id': businessId },
    areaServed: ['Ireland', 'Spain'],
  },
}));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.url}/#website`,
      url: `${siteConfig.url}/`,
      name: siteConfig.name,
      inLanguage: ['es-ES', 'en-IE'],
      publisher: { '@id': businessId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      inLanguage: languageTag,
      isPartOf: { '@id': `${siteConfig.url}/#website` },
      about: { '@id': businessId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage.href,
        width: 1200,
        height: 630,
      },
    },
    {
      '@type': 'Organization',
      '@id': businessId,
      name: siteConfig.name,
      url: `${siteConfig.url}/`,
      description,
      logo: logoImage.href,
      image: ogImage.href,
      telephone: siteConfig.phone,
      ...(siteConfig.email ? { email: siteConfig.email } : {}),
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: siteConfig.phone,
        contactType: 'sales',
        availableLanguage: ['Spanish', 'English'],
        url: siteConfig.bookingUrl,
      },
      founder: {
        '@type': 'Person',
        '@id': `${siteConfig.url}/#marcos`,
        name: 'Marcos Álvarez',
      },
      areaServed: ['ES', 'IE'],
      knowsAbout: pageLanguage === 'en'
        ? ['Web development', 'Technical SEO', 'Custom software', 'AI automation']
        : ['Desarrollo web', 'SEO técnico', 'Software a medida', 'Automatizaciones con IA'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: pageLanguage === 'en' ? 'Digital services' : 'Servicios digitales',
        itemListElement: serviceOffers,
      },
      sameAs: profileUrls,
    },
    {
      '@type': 'Person',
      '@id': `${siteConfig.url}/#marcos`,
      name: 'Marcos Álvarez',
      jobTitle: 'Full Stack Developer',
      url: `${siteConfig.url}/`,
      worksFor: { '@id': businessId },
      homeLocation: { '@type': 'Place', name: 'Galway, Ireland' },
      sameAs: profileUrls,
      knowsAbout: ['Full-stack development', 'Technical SEO', 'SaaS', 'AI agents', 'Automation'],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteConfig.url}/#inkendar`,
      name: 'Inkendar',
      url: 'https://inkendar.netlify.app/',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: pageLanguage === 'en'
        ? 'Custom website and integrated booking system for tattoo studios.'
        : 'Web a medida y sistema de reservas integrado para estudios de tatuaje.',
      creator: { '@id': businessId },
    },
  ],
};
---

<!doctype html>
<html lang={pageLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {isLandingPage && (
      <link rel="preload" href="/assets/video/incamdi-hero-poster.webp" as="image" type="image/webp" fetchpriority="high" />
    )}
    <link rel="preload" href="/assets/fonts/space-grotesk-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Incamdi" />
    <meta property="og:locale" content={pageLanguage === 'en' ? siteConfig.alternateLocale : siteConfig.locale} />
    <meta property="og:locale:alternate" content={pageLanguage === 'en' ? siteConfig.locale : siteConfig.alternateLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{pageLanguage === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <div class="bg-grid" aria-hidden="true"></div>
    <slot />
    <ChatwootWidget />
  </body>
</html>

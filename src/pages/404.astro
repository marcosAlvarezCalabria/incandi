---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/ui/Logo.astro';
---

<BaseLayout
  title="Página no encontrada — Incandi"
  titleEn="Page not found — Incandi"
  description="La página que buscas no existe."
  descriptionEn="The page you are looking for does not exist."
  noindex
>
  <main class="not-found">
    <Logo href="/" />
    <p class="kicker">404</p>
    <h1 data-es="Esta página se ha quedado fría." data-en="This page has gone cold.">Esta página se ha quedado fría.</h1>
    <p data-es="Puede que la dirección haya cambiado. Vuelve al inicio y encendemos de nuevo." data-en="The address may have changed. Head back home and we'll get the ember going again.">Puede que la dirección haya cambiado. Vuelve al inicio y encendemos de nuevo.</p>
    <a class="btn btn-primary" href="/" data-es="Volver a Incandi" data-en="Back to Incandi">Volver a Incandi</a>
  </main>
  <style>
    .not-found{position:relative;z-index:1;display:grid;place-items:center;align-content:center;min-height:100svh;width:min(100% - 40px,760px);margin:auto;text-align:center}
    .not-found .logo{margin-bottom:56px}.not-found .kicker{margin-bottom:12px}.not-found h1{max-width:12ch;font-family:'Space Grotesk',sans-serif;font-size:clamp(2.75rem,8vw,5.25rem);letter-spacing:-.038em;line-height:1;margin-bottom:20px;text-wrap:balance}
    .not-found>p:not(.kicker){max-width:48ch;color:var(--muted);margin-bottom:30px}
  </style>
  <script>import '@/scripts/main';</script>
</BaseLayout>

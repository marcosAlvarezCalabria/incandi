---
interface Props {
  href?: string;
  compact?: boolean;
}
import { brandNameHtml } from '@/domain/brand';

const isEnglish = Astro.url.pathname.startsWith('/en');
const { href = isEnglish ? '/en/' : '/', compact = false } = Astro.props;
---

<a class:list={['logo', { 'logo--compact': compact }]} href={href}>
  <span class="logo__mark" aria-hidden="true">
    <img
      src="/assets/images/logo-incamdi-192.webp"
      width="192"
      height="192"
      alt={isEnglish ? 'Incamdi logo' : 'Logotipo de Incamdi'}
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="logo__lockup">
    <span class="logo__word" set:html={brandNameHtml('lower')} />
    <span class="logo__tagline">Tech Software Agency</span>
  </span>
</a>

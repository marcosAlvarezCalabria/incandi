---
interface Props {
  href?: string;
  compact?: boolean;
}
const { href = '#top', compact = false } = Astro.props;
---

<a class:list={['logo', { 'logo--compact': compact }]} href={href} aria-label="Incandi — inicio">
  <span class="logo__mark" aria-hidden="true">
    <img src="/assets/brand/logo-incandi.webp" width="768" height="768" alt="" decoding="async" />
  </span>
  <span class="logo__lockup">
    <span class="logo__word">incandi</span>
    <span class="logo__tagline">Tech Software Agency</span>
  </span>
</a>

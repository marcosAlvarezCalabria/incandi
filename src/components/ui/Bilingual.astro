---
interface Props {
  es: string;
  en: string;
  tag?: keyof HTMLElementTagNameMap;
  class?: string;
  [key: string]: unknown;
}

const { es, en, tag: Tag = 'span', class: className, ...attributes } = Astro.props;
const initialContent = Astro.url.pathname.startsWith('/en') ? en : es;
---

<Tag class={className} set:html={initialContent} {...attributes} />

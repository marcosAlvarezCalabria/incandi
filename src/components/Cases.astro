---
import { projects } from '@/domain/content';
import Bilingual from './ui/Bilingual.astro';
import Icon from './ui/Icon.astro';
---

<section id="casos" aria-labelledby="cases-title">
  <div class="wrap">
    <div class="section-label rv"><Bilingual es="Casos reales" en="Real work" /></div>
    <div class="head-2col rv">
      <div>
        <Bilingual tag="p" class="kicker" es="Proyectos en producción" en="Projects in production" />
        <Bilingual
          tag="h2"
          class="title"
          id="cases-title"
          es="Software y webs que usan clientes de verdad."
          en="Software and sites used by real clients."
        />
      </div>
      <Bilingual
        tag="p"
        es="Nada inventado. Estos son proyectos reales, algunos en uso a diario."
        en="Nothing made up. These are real projects, some in daily use."
      />
    </div>
    <div class="grid-auto cases-grid">
      {projects.map((project) => (
        <article class={`case case--${project.visual.variant} rv`}>
          <div class="case__media">
            <img
              src={project.visual.src}
              width={project.visual.width}
              height={project.visual.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            {project.visual.variant === 'agent' && (
              <div class="case-agent" aria-hidden="true">
                <div class="case-agent__flow">
                  <span class="case-agent__node">Hermes</span>
                  <span class="case-agent__arrow">→</span>
                  <strong class="case-agent__node case-agent__node--primary">Epoxi</strong>
                  <span class="case-agent__arrow">→</span>
                  <span class="case-agent__node">Epoxiron</span>
                </div>
                <Bilingual
                  tag="span"
                  class="case-agent__label"
                  es="Agente como servicio adaptado al cliente"
                  en="Agent as a Service tailored to the client"
                />
              </div>
            )}
          </div>
          <div class="case__body">
            <Bilingual tag="span" class={`badge ${project.badgeClass}`} es={project.badge.es} en={project.badge.en} />
            <h3>{project.name}</h3>
            <Bilingual tag="p" es={project.description.es} en={project.description.en} />
            <div class="tags" aria-label="Tecnologías" data-en-aria-label="Technologies">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            {project.links.length > 0 && (
              <div class="case__links">
                {project.links.map((link) => (
                  <a class="case__link" href={link.href} target="_blank" rel="noopener noreferrer" data-track={link.track}>
                    <Bilingual es={link.label.es} en={link.label.en} />
                    <Icon name="arrow" size={16} />
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
    <Bilingual
      tag="p"
      class="more rv"
      es="Y más proyectos: <b>Koko Atelier</b>, <b>CineHub</b> (SPA de cine con JWT) y <b>ConoXchange</b> (marketplace P2P de skills)."
      en="And more projects: <b>Koko Atelier</b>, <b>CineHub</b> (movie SPA with JWT) and <b>ConoXchange</b> (P2P skills marketplace)."
    />
  </div>
</section>

---
import { navItems } from '@/domain/content';
import { brandNameHtml } from '@/domain/brand';
import Bilingual from './ui/Bilingual.astro';
import Logo from './ui/Logo.astro';
---

<footer>
  <div class="foot-in">
    <Logo compact />
    <nav class="foot-links" aria-label="Navegación del pie" data-en-aria-label="Footer navigation">
      {navItems.map((item) => <Bilingual tag="a" href={item.href} es={item.label.es} en={item.label.en} />)}
      <Bilingual tag="a" href="#contacto" es="Contacto" en="Contact" />
    </nav>
    <Bilingual
      tag="p"
      class="foot-copy"
      es={`© 2026 ${brandNameHtml()} · Desarrollo web, SEO y automatizaciones a medida · Hecho en Galway 🔥`}
      en={`© 2026 ${brandNameHtml()} · Web development, SEO and custom automation · Made in Galway 🔥`}
    />
  </div>
</footer>

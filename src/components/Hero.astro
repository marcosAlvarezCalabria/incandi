---
import { siteConfig } from '@/config/site';
import '@/styles/hero-video.css';
import Bilingual from './ui/Bilingual.astro';
import Icon from './ui/Icon.astro';

const isEnglish = Astro.url.pathname.startsWith('/en');
const fireLetter = '<span class="hero-fire-i"><span class="sr-only">i</span><span class="hero-fire-i__stem" aria-hidden="true"></span><span class="hero-fire-i__flame" aria-hidden="true"></span></span>';
const fireSlogan = (html: string): string => html.replaceAll('i', fireLetter);

const heroSloganEs = fireSlogan(
  'Ponemos tu negocio <span class="glow">al rojo vivo</span>.',
);
const heroSloganEn = fireSlogan(
  'We get your business <span class="glow">red-hot</span>.',
);
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="bg-glow" aria-hidden="true"></div>
  <div class="wrap hero__layout">
    <div class="hero__content">
      <div class="eyebrow rv">
        <span class="dot" aria-hidden="true"></span>
        <Bilingual
          tag="h1"
          class="hero__seo-title"
          id="hero-title"
          es="Desarrollo web, SEO y automatización con IA · Incamdi"
          en="Web development, SEO and AI automation · Incamdi"
        />
      </div>
      <Bilingual
        tag="p"
        class="hero__title rv"
        es={heroSloganEs}
        en={heroSloganEn}
        data-hero-fire-title
      />
      <Bilingual
        tag="p"
        class="hero__lead rv"
        es="Webs a medida, posicionamiento en Google y automatizaciones que hacen crecer tu negocio de verdad. <b>No plantillas</b>: código real, hecho por un desarrollador que ya tiene SaaS en producción usados a diario por clientes reales."
        en="Custom websites, Google rankings and automation that actually grow your business. <b>No templates</b>: real code, built by a developer who already has SaaS in production used daily by real clients."
      />
      <div class="cta-row rv">
        <a
          class="btn btn-primary"
          href={siteConfig.bookingUrl}
          target={siteConfig.bookingIsExternal ? '_blank' : undefined}
          rel={siteConfig.bookingIsExternal ? 'noopener noreferrer' : undefined}
          data-track="booking-hero"
        >
          <Icon name="calendar" size={18} />
          <Bilingual es={siteConfig.bookingLabel.es} en={siteConfig.bookingLabel.en} />
        </a>
        <a class="btn btn-ghost" href="#casos" data-track="work-hero">
          <Bilingual es="Ver casos reales" en="See real work" />
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="trust rv" aria-label={isEnglish ? 'Specialties' : 'Especialidades'}>
        {
          [
            ['Software en producción', 'Software in production'],
            ['SEO técnico', 'Technical SEO'],
            ['Automatizaciones con IA', 'AI-powered automation'],
            ['Bilingüe ES / EN', 'Bilingual EN / ES'],
          ].map(([es, en]) => (
            <span class="chip"><Icon name="check" size={15} /><Bilingual es={es} en={en} /></span>
          ))
        }
      </div>
    </div>

    <div class="hero__visual" data-hero-video>
      <video
        class="hero__video"
        data-hero-video-media
        muted
        playsinline
        preload="none"
        poster="/assets/video/incamdi-hero-poster.webp"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src="/assets/video/incamdi-hero.mp4" type="video/mp4" />
      </video>
      <div class="hero__video-scrim" aria-hidden="true"></div>
      <a
        class="hero-video-link"
        data-hero-video-booking
        href={siteConfig.bookingUrl}
        target={siteConfig.bookingIsExternal ? '_blank' : undefined}
        rel={siteConfig.bookingIsExternal ? 'noopener noreferrer' : undefined}
        aria-label={isEnglish ? 'Book your call' : 'Reservar una llamada'}
        data-track="booking-video"
        hidden
      ></a>
    </div>
  </div>
</section>

---
import { navItems } from '@/domain/content';
import { siteConfig } from '@/config/site';
import Bilingual from './ui/Bilingual.astro';
import Logo from './ui/Logo.astro';

const isEnglish = Astro.url.pathname.startsWith('/en');
---

<header class="site-header" data-header>
  <nav class="nav-in" aria-label={isEnglish ? 'Main navigation' : 'Navegación principal'}>
    <Logo />
    <div class="nav-right">
      <div class="nav-links">
        {navItems.map((item) => <Bilingual tag="a" href={item.href} es={item.label.es} en={item.label.en} />)}
      </div>
      <div class="lang" role="group" aria-label={isEnglish ? 'Language' : 'Idioma'}>
        <a
          class:list={['lang-opt', { active: !isEnglish }]}
          href="/"
          lang="es"
          hreflang="es"
          rel="alternate"
          aria-current={!isEnglish ? 'page' : undefined}
        >ES</a>
        <a
          class:list={['lang-opt', { active: isEnglish }]}
          href="/en/"
          lang="en"
          hreflang="en"
          rel="alternate"
          aria-current={isEnglish ? 'page' : undefined}
        >EN</a>
      </div>
      <a
        class="nav-cta"
        href={siteConfig.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track="booking-nav"
      >
        <Bilingual es={siteConfig.bookingLabel.es} en={siteConfig.bookingLabel.en} />
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={isEnglish ? 'Open menu' : 'Abrir menú'}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu__inner">
      <nav class="mobile-menu__links" aria-label={isEnglish ? 'Mobile navigation' : 'Navegación móvil'}>
        {navItems.map((item, index) => (
          <Bilingual tag="a" href={item.href} es={item.label.es} en={item.label.en} data-menu-link style={`--menu-index:${index}`} />
        ))}
      </nav>
      <a
        class="btn btn-primary mobile-menu__cta"
        href={siteConfig.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track="booking-mobile"
      >
        <Bilingual es={siteConfig.bookingLabel.es} en={siteConfig.bookingLabel.en} />
      </a>
    </div>
  </div>
</header>
